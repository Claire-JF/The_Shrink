# ── PowerShell tip (optional). Prefer editing this file as `.env`:
#   $env:CLOD_API_KEY = "YOUR_KEY_HERE"
#   $env:LLM_FAST_MODEL = "Trinity Mini"
# Model names with spaces MUST be quoted in PowerShell.
#
# Backend-1 (Electron)
# MOCK_SELECTION=1 uses stub text (no Ctrl+C automation). Unset for real Windows capture.
# DEMO_MODE=1 same as --demo-mode (widget always opens regardless of score threshold).
# SCORE_EXPAND_THRESHOLD=3

# Backend-2 / CLōD (OpenAI-compatible). Omit CLOD_API_KEY to use the in-process mock LLM.
CLOD_API_KEY=
LLM_BASE_URL=https://api.clod.io/v1
# Defaults in backend1/config.js: DeepSeek V3. Alicia track often uses Qwen on CLōD:
# LLM_FAST_MODEL=Qwen2.5 7B
# LLM_DEEP_MODEL=Qwen2.5 72B
LLM_FAST_MODEL=DeepSeek V3
LLM_DEEP_MODEL=DeepSeek V3
# Optional: mock input / chat (defaults to LLM_DEEP_MODEL)
LLM_CHAT_MODEL=

# To try OpenAI instead, point base URL and key:
# LLM_BASE_URL=https://api.openai.com/v1
# CLOD_API_KEY=sk-...
# LLM_FAST_MODEL=gpt-4o-mini
# LLM_DEEP_MODEL=gpt-4o
